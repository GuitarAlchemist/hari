/target
**/*.rs.bk
*.pdb

# Python bytecode caches — the IX reference client under clients/
# uses the ambient Python interpreter and writes caches alongside.
__pycache__/
*.pyc

# Octopus / Claude Code session state — local-only, do not commit
.octo/
.claude-octopus/
.claude/
.octo-factory-launch.log
.octo-review.log

# hari-harness event log — append-only source of truth, can grow large.
# The derived `belief-snapshot.json` / `belief-diff.json` ARE worth committing.
state/harness/events.jsonl
state/harness/belief-state.json
