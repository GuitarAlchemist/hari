/target
**/*.rs.bk
*.pdb

# Python bytecode caches — the IX reference client under clients/
# uses the ambient Python interpreter and writes caches alongside.
__pycache__/
*.pyc

# Octopus / Claude Code session state — local-only, do not commit
.octo/
.claude-octopus/
.octo-factory-launch.log
.octo-review.log

# Claude Code: track hooks/settings/skills (shared infra), ignore per-session scratch
.claude/*
!.claude/hooks/
!.claude/settings.json
!.claude/skills/
!.claude/commands/
.claude/settings.local.json
.claude/worktrees/
.claude/local/

# Session digests — per-session cursor state, README.md tracked
state/digests/*
!state/digests/README.md
